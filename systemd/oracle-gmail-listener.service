# Template: scripts/install.sh fills in @REPO@ and @NODE@.
[Unit]
Description=Netflix household auto-approval (Gmail listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@NODE@ src/listener.js
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/oracle-gmail-listener
PrivateTmp=true

[Install]
WantedBy=default.target

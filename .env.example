# scripts/install.sh copies this file to ~/.config/oracle-gmail-listener/config.env (mode 600).
# Never commit the filled-in copy.

# The Gmail inbox that receives the Netflix account emails.
GMAIL_ADDRESS=you@gmail.com
# A Gmail app password (https://myaccount.google.com/apppasswords), not your Google password.
GMAIL_APP_PASSWORD=replace-with-app-password
NETFLIX_SENDER=info@account.netflix.com
# All Mail also sees messages that Gmail filters archived or labelled.
GMAIL_MAILBOX=[Gmail]/All Mail
# Older messages are ignored; Netflix approval links expire after about 15 minutes.
MAX_EMAIL_AGE_MINUTES=15
# Fallback check in case a push notification from Gmail is missed (30-3600).
POLL_INTERVAL_SECONDS=60
# Gmail's push notification can arrive several seconds after the email. Set 1-30 to also ask
# Gmail for new mail this often (a tiny request); 0 = rely on push only.
QUICK_CHECK_SECONDS=0
# auto   = approve every household update request as soon as its email arrives.
# review = only queue requests; list them with `npm run review`.
APPROVAL_MODE=auto
# browser    = confirm in a headless browser (default).
# http-first = confirm with a direct HTTP request (about a second, no browser); the browser
#              is used only when that request is not confirmed by Netflix.
APPROVAL_TRANSPORT=browser
